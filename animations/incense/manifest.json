{
  "id": "incense",
  "name": "Incense",
  "description": "Smoke particle simulation rising from an incense stick with wind and turbulence controls.",
  "author": "Luci Evol",
  "version": "1.0.0",
  "preview": "preview.gif",
  "params": [
    {
      "key": "speed",
      "type": "range",
      "label": "Speed",
      "defaultValue": 1,
      "min": 0.2,
      "max": 4,
      "step": 0.1,
      "integer": false
    },
    {
      "key": "smokeDensity",
      "type": "range",
      "label": "Smoke Density",
      "defaultValue": 1,
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "integer": false
    },
    {
      "key": "smokeLifespan",
      "type": "range",
      "label": "Smoke Lifespan",
      "defaultValue": 1,
      "min": 0.5,
      "max": 4,
      "step": 0.1,
      "integer": false
    },
    {
      "key": "smokeColor",
      "type": "select",
      "label": "Smoke Color",
      "defaultValue": "warm",
      "options": [
        "warm",
        "cool",
        "incense",
        "sage",
        "lavender",
        "mono"
      ]
    },
    {
      "key": "windDirection",
      "type": "range",
      "label": "Wind Direction",
      "defaultValue": 0,
      "min": -1,
      "max": 1,
      "step": 0.05,
      "integer": false
    },
    {
      "key": "windSpeed",
      "type": "range",
      "label": "Wind Speed",
      "defaultValue": 0.3,
      "min": 0,
      "max": 2,
      "step": 0.05,
      "integer": false
    },
    {
      "key": "randomization",
      "type": "range",
      "label": "Randomization",
      "defaultValue": 0.8,
      "min": 0,
      "max": 2,
      "step": 0.05,
      "integer": false
    }
  ]
}
