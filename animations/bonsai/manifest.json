{
  "id": "bonsai",
  "name": "Bonsai",
  "description": "A peaceful procedural tree growth simulation that brings digital nature to your terminal. It features customizable leaf density and rest times between redraws, letting you watch a unique bonsai tree slowly take shape, flourish, and then clear to begin anew.",
  "author": "Luci Evol - www.evoldigitalproductions.com",
  "version": "1.0.0",
  "preview": "preview.gif",
  "params": [
    {
      "key": "speed",
      "type": "range",
      "label": "Speed",
      "defaultValue": 1,
      "min": 0.2,
      "max": 4,
      "step": 0.1,
      "integer": false
    },
    {
      "key": "palette",
      "type": "select",
      "label": "Palette",
      "defaultValue": "natural",
      "options": [
        "natural",
        "autumn",
        "sakura",
        "cherry",
        "purple",
        "mono"
      ]
    },
    {
      "key": "leafDensity",
      "type": "range",
      "label": "Leaf Density",
      "defaultValue": 1,
      "min": 0.2,
      "max": 2,
      "step": 0.05,
      "integer": false
    },
    {
      "key": "holdTime",
      "type": "range",
      "label": "Hold Time",
      "defaultValue": 360,
      "min": 60,
      "max": 900,
      "step": 30,
      "integer": true
    }
  ]
}
