{
  "id": "fluid",
  "name": "Fluid",
  "description": "A real-time fluid dynamics simulation with interactive dye injection. Rendered entirely in ASCII, the solver computes velocity and pressure fields to create incredibly smooth and realistic swirling vortices across your terminal.",
  "author": "Luci Evol - www.evoldigitalproductions.com",
  "version": "1.0.0",
  "preview": "preview.gif",
  "params": [
    {
      "key": "speed",
      "type": "range",
      "label": "Speed",
      "defaultValue": 1,
      "min": 0.2,
      "max": 4,
      "step": 0.1,
      "integer": false
    },
    {
      "key": "palette",
      "type": "select",
      "label": "Palette",
      "defaultValue": "plasma",
      "options": [
        "plasma",
        "ocean",
        "fire",
        "neon",
        "mono"
      ]
    },
    {
      "key": "resolution",
      "type": "select",
      "label": "Resolution",
      "defaultValue": "medium",
      "options": [
        "low",
        "medium",
        "high",
        "ultra"
      ]
    },
    {
      "key": "diffusion",
      "type": "range",
      "label": "Diffusion",
      "defaultValue": 0.0001,
      "min": 0,
      "max": 0.01,
      "step": 0.0001,
      "integer": false
    },
    {
      "key": "viscosity",
      "type": "range",
      "label": "Viscosity",
      "defaultValue": 0,
      "min": 0,
      "max": 0.001,
      "step": 5e-05,
      "integer": false
    },
    {
      "key": "dyeFade",
      "type": "range",
      "label": "Dye Fade",
      "defaultValue": 0.995,
      "min": 0.98,
      "max": 1,
      "step": 0.001,
      "integer": false
    }
  ]
}
