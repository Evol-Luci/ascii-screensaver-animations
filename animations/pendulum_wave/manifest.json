{
  "id": "pendulum_wave",
  "name": "Pendulum Wave",
  "description": "Pendulums of progressively shorter period swinging in and out of phase \u2014 travelling waves that periodically snap back into perfect sync.",
  "author": "Luci Evol",
  "version": "1.0.0",
  "preview": "preview.gif",
  "params": [
    {
      "key": "speed",
      "type": "range",
      "label": "Speed",
      "defaultValue": 0.25,
      "min": 0.05,
      "max": 1,
      "step": 0.025,
      "integer": false
    },
    {
      "key": "palette",
      "type": "select",
      "label": "Palette",
      "defaultValue": "spectrum",
      "options": [
        "spectrum",
        "warm",
        "cool",
        "mono"
      ]
    },
    {
      "key": "pendulumCount",
      "type": "range",
      "label": "Pendulum Count",
      "defaultValue": 18,
      "min": 8,
      "max": 24,
      "step": 1,
      "integer": true
    },
    {
      "key": "cycleTime",
      "type": "range",
      "label": "Cycle Time",
      "defaultValue": 8,
      "min": 4,
      "max": 16,
      "step": 0.5,
      "integer": false
    },
    {
      "key": "swingAngle",
      "type": "range",
      "label": "Swing Angle",
      "defaultValue": 0.4,
      "min": 0.1,
      "max": 0.8,
      "step": 0.05,
      "integer": false
    }
  ]
}
