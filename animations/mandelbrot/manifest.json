{
  "id": "mandelbrot",
  "name": "Mandelbrot",
  "description": "A deeply zooming ASCII fractal explorer. The simulation automatically navigates the Mandelbrot set, intelligently jumping between interesting boundary regions and rendering the infinitely complex mathematical shapes in crisp terminal characters.",
  "author": "Luci Evol - www.evoldigitalproductions.com",
  "version": "1.0.0",
  "preview": "preview.gif",
  "params": [
    {
      "key": "speed",
      "type": "range",
      "label": "Speed",
      "defaultValue": 1,
      "min": 0.2,
      "max": 4,
      "step": 0.1,
      "integer": false
    },
    {
      "key": "palette",
      "type": "select",
      "label": "Palette",
      "defaultValue": "classic",
      "options": [
        "classic",
        "fire",
        "ocean",
        "neon",
        "mono"
      ]
    },
    {
      "key": "maxIter",
      "type": "range",
      "label": "Max Iter",
      "defaultValue": 64,
      "min": 16,
      "max": 256,
      "step": 16,
      "integer": true
    },
    {
      "key": "charset",
      "type": "select",
      "label": "Charset",
      "defaultValue": "classic",
      "options": [
        "classic",
        "blocks",
        "dots"
      ]
    },
    {
      "key": "autoJump",
      "type": "select",
      "label": "Auto Jump",
      "defaultValue": 1,
      "options": [
        0,
        1
      ]
    }
  ]
}
