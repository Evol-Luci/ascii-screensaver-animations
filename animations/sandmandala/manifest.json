{
  "id": "sandmandala",
  "name": "Sand Mandala",
  "description": "Radial sand mandala that builds grain by grain, holds, dissolves, and rebuilds.",
  "author": "Luci Evol",
  "version": "1.0.0",
  "preview": "preview.gif",
  "params": [
    {
      "key": "speed",
      "type": "range",
      "label": "Speed",
      "defaultValue": 1,
      "min": 0.2,
      "max": 4,
      "step": 0.1,
      "integer": false
    },
    {
      "key": "palette",
      "type": "select",
      "label": "Palette",
      "defaultValue": "tibetan",
      "options": [
        "tibetan",
        "desert",
        "ocean",
        "jewel",
        "mono"
      ]
    },
    {
      "key": "symmetry",
      "type": "select",
      "label": "Symmetry",
      "defaultValue": 8,
      "options": [
        4,
        6,
        8,
        12
      ]
    },
    {
      "key": "holdTime",
      "type": "range",
      "label": "Hold Time",
      "defaultValue": 300,
      "min": 0,
      "max": 900,
      "step": 30,
      "integer": true
    },
    {
      "key": "dissolveStyle",
      "type": "select",
      "label": "Dissolve Style",
      "defaultValue": "wind",
      "options": [
        "sweep",
        "wind",
        "fade"
      ]
    }
  ]
}
