{
  "id": "matrix",
  "name": "Matrix",
  "description": "Digital rain effect in ASCII.",
  "author": "Luci Evol",
  "version": "1.0.0",
  "preview": "preview.gif",
  "params": [
    {
      "key": "speed",
      "type": "range",
      "label": "Speed",
      "description": "How fast the characters fall.",
      "defaultValue": 1,
      "min": 0.2,
      "max": 4,
      "step": 0.1,
      "integer": false
    },
    {
      "key": "palette",
      "type": "select",
      "label": "Palette",
      "description": "Color scheme used for the falling characters.",
      "defaultValue": "green",
      "options": [
        "green",
        "blue",
        "red",
        "hacker"
      ]
    },
    {
      "key": "density",
      "type": "range",
      "label": "Density",
      "description": "How many character columns are active at once.",
      "defaultValue": 1,
      "min": 0.1,
      "max": 2.0,
      "step": 0.1,
      "integer": false
    }
  ]
}
