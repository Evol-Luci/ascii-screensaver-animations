{
  "id": "dna",
  "name": "DNA Helix",
  "description": "3D rotating DNA double helix structure.",
  "author": "Luci Evol",
  "version": "1.0.0",
  "preview": "preview.gif",
  "params": [
    {
      "key": "speed",
      "type": "range",
      "label": "Rotation Speed",
      "description": "How fast the helix spins.",
      "defaultValue": 1,
      "min": 0.1,
      "max": 3.0,
      "step": 0.1,
      "integer": false
    },
    {
      "key": "zoom",
      "type": "range",
      "label": "Zoom Level",
      "description": "How close the camera sits to the helix.",
      "defaultValue": 1,
      "min": 0.5,
      "max": 2.0,
      "step": 0.1,
      "integer": false
    },
    {
      "key": "palette",
      "type": "select",
      "label": "Palette",
      "description": "Color scheme used to draw the base pairs.",
      "defaultValue": "classic",
      "options": [
        "classic",
        "neon"
      ]
    }
  ]
}
