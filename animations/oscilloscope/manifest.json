{
  "id": "oscilloscope",
  "name": "Oscilloscope",
  "description": "A simulation of a CRT lab instrument left running forever in a forgotten workshop. It renders a glowing phosphor Lissajous trace with adjustable decay, authentic scanlines, and a warm cathode-ray bloom effect.",
  "author": "Luci Evol - www.evoldigitalproductions.com",
  "version": "1.0.0",
  "preview": "preview.gif",
  "params": [
    {
      "key": "speed",
      "type": "range",
      "label": "Speed",
      "defaultValue": 1,
      "min": 0.2,
      "max": 4,
      "step": 0.1,
      "integer": false
    },
    {
      "key": "complexity",
      "type": "range",
      "label": "Complexity",
      "defaultValue": 3,
      "min": 1,
      "max": 6,
      "step": 1,
      "integer": true
    },
    {
      "key": "phosphorDecay",
      "type": "range",
      "label": "Phosphor Decay",
      "defaultValue": 0.92,
      "min": 0.8,
      "max": 0.99,
      "step": 0.01,
      "integer": false
    },
    {
      "key": "noise",
      "type": "range",
      "label": "Noise",
      "defaultValue": 0.2,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "integer": false
    },
    {
      "key": "palette",
      "type": "select",
      "label": "Palette",
      "defaultValue": "phosphor",
      "options": [
        "phosphor",
        "amber",
        "blue"
      ]
    },
    {
      "key": "shapeSet",
      "type": "select",
      "label": "Shape Set",
      "defaultValue": "all",
      "options": [
        "all",
        "curves",
        "geometric",
        "waveforms"
      ]
    },
    {
      "key": "cyclePeriod",
      "type": "range",
      "label": "Cycle Period",
      "defaultValue": 14,
      "min": 4,
      "max": 40,
      "step": 1,
      "integer": true
    },
    {
      "key": "morphTime",
      "type": "range",
      "label": "Morph Time",
      "defaultValue": 1.5,
      "min": 0.3,
      "max": 5,
      "step": 0.1,
      "integer": false
    }
  ]
}
