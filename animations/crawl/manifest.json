{
  "id": "crawl",
  "name": "Crawl",
  "description": "Retro title crawl with selectable episode and text speed.",
  "author": "Luci Evol",
  "version": "1.0.0",
  "preview": "preview.gif",
  "params": [
    {
      "key": "speed",
      "type": "range",
      "label": "Speed",
      "defaultValue": 1,
      "min": 0.2,
      "max": 4,
      "step": 0.1,
      "integer": false
    },
    {
      "key": "palette",
      "type": "select",
      "label": "Palette",
      "defaultValue": "gold",
      "options": [
        "gold",
        "white",
        "green",
        "blue",
        "red"
      ]
    },
    {
      "key": "episode",
      "type": "range",
      "label": "Episode",
      "defaultValue": -1,
      "min": -1,
      "max": 5,
      "step": 1,
      "integer": true
    }
  ]
}
